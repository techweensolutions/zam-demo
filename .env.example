# Copy to .env and fill in. The server reads the environment, so start it with:
#   set -a; . ./.env; set +a; node server.js
#
# The ZAM Service the stores pay through. For staging, its public address.
ZAM_BASE_URL=https://zam-staging.example

# One SECRET key per store, each from its own online POS (portal: Checkout Keys,
# "Secret key"). Never commit this file.
ZAM_KEY_XCITE=
ZAM_KEY_TRAVEL=
ZAM_KEY_TALABAT=

PORT=8090

# Only if ZAM reports a pay-page address your browser cannot reach:
# ZAM_PAY_BASE=https://zam-staging.example

# Only if this server is reachable from ZAM over https: the signing secret of a
# webhook endpoint registered for the store's POS (portal: Checkout Keys,
# Webhook endpoints), pointing at https://<this server>/zam/webhook/<store>.
# Without it the stores confirm payment by asking ZAM, which works anywhere.
# ZAM_WHSEC_XCITE=
# ZAM_WHSEC_TRAVEL=
# ZAM_WHSEC_TALABAT=
